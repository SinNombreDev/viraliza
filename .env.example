# ─────────────────────────────────────────────────────────────────────────────
# Viraliza environment configuration
# Copy to `.env` (root) and fill in what you have. EVERYTHING runs in mock mode
# when the real keys are absent, so you can start with an empty file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Public base URL of the web app / API (used to build short links & webhooks)
APP_URL=http://localhost:3000
# Secret used to sign short links, sessions and webhooks. CHANGE IN PRODUCTION.
APP_SECRET=change-me-to-a-long-random-string

# ── Data ─────────────────────────────────────────────────────────────────────
# Leave empty to use the zero-setup in-memory store (dev only).
# Set to a Postgres URL for real persistence (production).
#   Postgres: postgresql://user:pass@host:5432/viraliza
DATABASE_URL=""

# ── AI sales agent ───────────────────────────────────────────────────────────
# provider: mock | openai | azure-openai
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# provider: mock | cloud   (cloud = Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Marketplaces (affiliate programmes) ──────────────────────────────────────
# provider: mock | live  (per marketplace). `mock` returns realistic demo data.
MARKETPLACE_MODE=mock

# Mercado Livre / Mercado Livre Afiliados
ML_APP_ID=
ML_CLIENT_SECRET=
ML_AFFILIATE_ID=
ML_ACCESS_TOKEN=

# Shopee Affiliate (via Shopee Affiliate Open API / partner gateway)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_AFFILIATE_ID=

# Amazon Associates / Product Advertising API
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_REGION=com.br

# ── Business rules ───────────────────────────────────────────────────────────
# Percentage of the GROSS affiliate commission that Viraliza keeps as its fee.
PLATFORM_FEE_PERCENT=20
# Default marketplace commission rate (percent of order value) when the source
# does not provide one. Real values override this per product/category.
DEFAULT_COMMISSION_PERCENT=8
# Referral bonus: percent of a referred user's net commission paid to referrer.
REFERRAL_PERCENT=5
CURRENCY=BRL

# ── Monetisation plans ───────────────────────────────────────────────────────
PRICE_PRO_MONTHLY=29.90
PRICE_PRO_ONE_TIME=199.00
PRICE_BUSINESS_MONTHLY=99.90
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PIX_KEY=
